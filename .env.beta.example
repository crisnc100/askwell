# Settings for the hosted beta (compose.prod.yaml). Copy to .env.beta on the host and
# fill in. Never commit .env.beta.

# A beta-only Anthropic API key for the default model (anthropic:claude-haiku-5-5), with
# a spend limit set in the Anthropic console.
ANTHROPIC_API_KEY=

# Only needed if ASKWELL_DEFAULT_MODEL names an OpenRouter model instead.
# OPENROUTER_API_KEY=

# The most all live answers together may cost per UTC day, in USD.
ASKWELL_DAILY_SPEND_CAP_USD=1.00

# The kill switch: set to 1 to turn live answers off. The app reads it when it starts.
ASKWELL_LIVE_ANSWERS_OFF=0

# Features to switch off, comma-separated (link_roles, inferred_links, numeric_text).
# compose.prod.yaml sets this itself, which wins over this file.
ASKWELL_FEATURES_OFF=
