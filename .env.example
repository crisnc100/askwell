# Copy to .env and fill in. Never commit .env.

# --- OpenRouter (only needed for live/record runs; replay mode needs no key) ---
# BEFORE using a key here, set a credit limit on it at https://openrouter.ai/settings/keys
# (Edit key -> Credit limit). That limit is the backstop if a budget guard ever fails.
# Project budget: $50/month across all betas; every live run also takes --budget.
OPENROUTER_API_KEY=

# Model ids are config only. Pick them from ADR-004 (model spike).
LEDGERLINE_DEFAULT_MODEL=
LEDGERLINE_SECOND_MODEL=

# record | replay | live
LEDGERLINE_LLM_MODE=replay

# --- Reference time (seeder, prompt date, relative dates, gold results) ---
LEDGERLINE_NOW=2026-06-30T00:00:00Z

# --- Local Postgres from docker compose (host port 55432) ---
# Local development credentials only. Change them for anything shared.
LEDGERLINE_DB_PORT=55432
LEDGERLINE_OWNER_PASSWORD=ledgerline
LEDGERLINE_RO_PASSWORD=ledgerline_ro
LEDGERLINE_DATABASE_URL=postgresql+psycopg://ledgerline_owner:ledgerline@localhost:55432/ledgerline
LEDGERLINE_DATABASE_RO_URL=postgresql+psycopg://ledgerline_ro:ledgerline_ro@localhost:55432/ledgerline
