# Copy to .env and fill in. Never commit .env.

# --- OpenRouter (live/record runs of models not named anthropic:<id>; replay needs no key) ---
# BEFORE using a key here, set a credit limit on it at https://openrouter.ai/settings/keys
# (Edit key -> Credit limit). That limit is the backstop if a budget guard ever fails.
# Project budget: $50/month across all betas; every live run also takes --budget.
OPENROUTER_API_KEY=

# --- Anthropic API (for models named anthropic:<id>, the default included) ---
ANTHROPIC_API_KEY=

# Model names are config only; ADR-004 records how they were chosen. Leave these
# commented out to use the defaults in askwell/config.py.
# ASKWELL_DEFAULT_MODEL=anthropic:claude-haiku-5-5
# ASKWELL_SECOND_MODEL=google/gemma-4-26b-a4b-it

# record | replay | live
ASKWELL_LLM_MODE=replay

# --- Reference time (seeder, prompt date, relative dates, gold results) ---
ASKWELL_NOW=2026-06-30T00:00:00Z

# --- Local Postgres from docker compose (host port 56432) ---
# Local development credentials only. Change them for anything shared.
ASKWELL_DB_PORT=56432
ASKWELL_OWNER_PASSWORD=askwell
ASKWELL_RO_PASSWORD=askwell_ro
ASKWELL_DATABASE_URL=postgresql+psycopg://askwell_owner:askwell@localhost:56432/askwell
ASKWELL_DATABASE_RO_URL=postgresql+psycopg://askwell_ro:askwell_ro@localhost:56432/askwell
# Askwell's own tables (the ask_log audit). The read-only role cannot connect to it.
ASKWELL_APP_DATABASE_URL=postgresql+psycopg://askwell_owner:askwell@localhost:56432/askwell_app

# --- Your data (uploaded workspaces) ---
# Where workspace folders live. Default: data/workspaces
# ASKWELL_WORKSPACE_DIR=data/workspaces
# Read the client address from X-Forwarded-For. Set it to 1 only behind a proxy that
# writes that header; otherwise any client could claim any address.
# ASKWELL_TRUST_PROXY=1
